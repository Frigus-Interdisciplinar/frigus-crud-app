<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- tela de carregamento: fica escondida e o script-carregando.js mostra quando a pessoa troca de tela ( usa ctx ) --%>
    <div class="carregando" id="carregando" role="status" aria-live="polite" data-riv="${ctx}/assets/animacoes/friguinho.riv" hidden>
        <!-- Decoração: flocos desenhados e neve caindo -->
        <div class="flakes" aria-hidden="true">
            <img class="sf sf--1" src="${ctx}/assets/img/erro/floco-claro.svg" alt="">
            <img class="sf sf--2" src="${ctx}/assets/img/erro/floco-claro.svg" alt="">
            <img class="sf sf--3" src="${ctx}/assets/img/erro/floco-claro.svg" alt="">
            <img class="sf sf--4" src="${ctx}/assets/img/erro/floco-claro.svg" alt="">
        </div>
        <div class="neve-css" aria-hidden="true"></div>

        <div class="carregando-centro">
            <div class="friguinho" aria-hidden="true">
                <div class="friguinho-halo"></div>
                <canvas class="friguinho-fonte" width="500" height="500"></canvas>
                <canvas class="friguinho-tela" width="500" height="500"></canvas>
            </div>

            <h2 class="carregando-titulo">Carregando...</h2>
            <p class="carregando-texto">O Friguinho está organizando a sua geladeira.</p>

            <div class="barra" role="progressbar" aria-label="Progresso do carregamento" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div class="barra-cheia"></div>
            </div>

            <p class="tip"><strong>Dica</strong><span class="dica-texto">Os itens perto de vencer aparecem primeiro na sua lista.</span></p>
        </div>

        <!-- Decoração: montes de neve na base -->
        <svg class="drift" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
            <path class="d2" d="M0 66C180 18 360 22 540 60S900 34 1100 40 1360 70 1440 48V140H0Z"/>
            <path class="d1" d="M0 100C200 62 380 82 600 96S1000 70 1200 86 1400 100 1440 92V140H0Z"/>
        </svg>
    </div>
