<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- botoes para navegar nas paginas da lista ( usa pagina, totalPaginas e queryPagina vindos do Paginacao ) --%>
<c:if test="${totalPaginas > 1}">
    <nav class="paginacao">
        <c:choose>
            <c:when test="${pagina > 1}">
                <a href="?pagina=1<c:out value='${queryPagina}'/>">« Primeira</a>
                <a href="?pagina=${pagina - 1}<c:out value='${queryPagina}'/>">‹ Anterior</a>
            </c:when>
            <c:otherwise>
                <span>« Primeira</span>
                <span>‹ Anterior</span>
            </c:otherwise>
        </c:choose>

        <strong>Página ${pagina} de ${totalPaginas}</strong>

        <c:choose>
            <c:when test="${pagina < totalPaginas}">
                <a href="?pagina=${pagina + 1}<c:out value='${queryPagina}'/>">Próxima ›</a>
                <a href="?pagina=${totalPaginas}<c:out value='${queryPagina}'/>">Última »</a>
            </c:when>
            <c:otherwise>
                <span>Próxima ›</span>
                <span>Última »</span>
            </c:otherwise>
        </c:choose>
    </nav>
</c:if>
